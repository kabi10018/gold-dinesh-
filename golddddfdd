<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>XAUUSD. – 16yr Old trader studying 12th Std</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b0a09;
    --bg-2:#100f0d;
    --text:#ffffff;
    --muted:#a9a9ad;
    --line:rgba(255,255,255,.12);
    --blue:#16206b;
    --sans:'Plus Jakarta Sans',system-ui,sans-serif;
    --serif:'Instrument Serif',Georgia,serif;
    --mono:'JetBrains Mono',ui-monospace,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  em{font-family:var(--serif);font-style:italic;font-weight:400}


  /* ---------- TOP QUOTE BAR ---------- */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:70;padding:11px 14px;text-align:center;overflow:hidden;
    background:linear-gradient(90deg,#b8860b,#ffd54a,#fff3b0,#ffd54a,#b8860b);background-size:200% 100%;
    color:#1a1200;font-size:clamp(13px,3.5vw,20px);font-weight:800;letter-spacing:.04em;line-height:1.3;text-transform:uppercase;
    box-shadow:0 4px 22px rgba(255,200,40,.55),0 0 0 1px rgba(255,255,255,.35) inset;
    animation:goldShift 4s linear infinite}
  .topbar em{font-size:1.12em;font-weight:400;text-transform:none;letter-spacing:0;color:#000}
  .topbar::after{content:"";position:absolute;top:0;bottom:0;width:60px;left:-80px;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.75),transparent);
    transform:skewX(-20deg);animation:shine 3.2s ease-in-out infinite}
  @keyframes goldShift{to{background-position:-200% 0}}
  @keyframes shine{0%{left:-80px}60%,100%{left:110%}}


  /* ---------- GOLD / XAUUSD ---------- */
  .age-badge{display:inline-flex;align-items:center;gap:10px;padding:9px 20px;border-radius:999px;
    border:1.5px solid rgba(255,213,74,.65);background:rgba(255,213,74,.12);color:#ffd54a;
    font-family:var(--mono);font-weight:700;letter-spacing:.14em;font-size:clamp(12px,3.3vw,17px);
    box-shadow:0 0 22px rgba(255,200,40,.25)}
  .age-badge i{width:8px;height:8px;border-radius:50%;background:#ffd54a;box-shadow:0 0 10px #ffd54a;animation:pulse 1.6s ease-in-out infinite}
  @keyframes pulse{50%{opacity:.25}}
  .xau{margin-top:18px;display:flex;flex-direction:column;align-items:center;gap:8px}
  .xau .word{font-size:clamp(56px,19vw,170px);font-weight:900;letter-spacing:-.04em;line-height:.95;
    background:linear-gradient(100deg,#b8860b 0%,#ffd54a 25%,#fff3b0 50%,#ffd54a 75%,#b8860b 100%);background-size:200% 100%;
    -webkit-background-clip:text;background-clip:text;color:transparent;
    animation:goldShift 4s linear infinite;filter:drop-shadow(0 0 30px rgba(255,200,40,.45))}
  .xau .sub{font-family:var(--mono);color:#e9d8a6;letter-spacing:.28em;font-size:clamp(10px,2.8vw,15px);font-weight:600}
  .gold-icons{display:flex;gap:clamp(12px,4vw,28px);align-items:flex-end;justify-content:center;margin-top:22px}
  .gold-icons svg{width:clamp(56px,16vw,96px);height:auto;filter:drop-shadow(0 6px 18px rgba(255,200,40,.35))}
  .gold-icons .float{animation:floaty 3.4s ease-in-out infinite}
  .gold-icons .float:nth-child(2){animation-delay:-1.1s}
  .gold-icons .float:nth-child(3){animation-delay:-2.2s}
  @keyframes floaty{50%{transform:translateY(-8px)}}
  .track span.gold{background:linear-gradient(90deg,#b8860b,#ffd54a,#fff3b0,#ffd54a);-webkit-background-clip:text;background-clip:text;color:transparent}

  /* ---------- NAV PILL ---------- */
  .nav{
    position:fixed;top:56px;left:50%;transform:translateX(-50%);
    width:min(92%,1000px);height:64px;padding:0 30px;
    display:flex;align-items:center;justify-content:space-between;
    border:1.5px solid rgba(255,255,255,.14);border-radius:999px;
    background:rgba(14,14,16,.55);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    z-index:60;transition:background .3s;
  }
  .logo{font-weight:800;font-size:22px;letter-spacing:.12em}
  .burger{width:34px;height:34px;background:none;border:0;cursor:pointer;position:relative;color:#fff}
  .burger span{position:absolute;left:3px;right:3px;height:2.5px;background:#d8d8da;border-radius:2px;transition:.3s}
  .burger span:nth-child(1){top:8px}
  .burger span:nth-child(2){top:16px}
  .burger span:nth-child(3){top:24px}
  .menu-open .burger span:nth-child(1){top:16px;transform:rotate(45deg)}
  .menu-open .burger span:nth-child(2){opacity:0}
  .menu-open .burger span:nth-child(3){top:16px;transform:rotate(-45deg)}
  .menu-open .nav{background:#070707}

  /* ---------- MENU OVERLAY ---------- */
  .overlay{
    position:fixed;inset:0;background:#070707;z-index:50;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:150px 8% 40px;opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s;
  }
  .menu-open .overlay{opacity:1;visibility:visible}
  .overlay .label{font-family:var(--mono);letter-spacing:.3em;font-size:14px;color:#6d6d70;margin-bottom:40px}
  .overlay ul{list-style:none;width:100%;max-width:880px}
  .overlay li{border-bottom:1px solid rgba(255,255,255,.1)}
  .overlay li a{display:block;text-align:center;font-size:clamp(26px,5vw,40px);font-weight:600;padding:22px 0;color:#d9d9db;letter-spacing:-.02em;transition:color .2s}
  .overlay li a:hover{color:#fff}
  .overlay .join{
    margin-top:40px;width:100%;max-width:880px;height:76px;border:1.5px solid rgba(255,255,255,.14);
    border-radius:999px;background:#0f0f0f;display:flex;align-items:center;justify-content:center;
    font-size:18px;letter-spacing:.06em;color:#e6e6e8;transition:background .2s
  }
  .overlay .join:hover{background:#181818}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;
    padding:230px 20px 90px;text-align:center;overflow:hidden;
    background:linear-gradient(180deg,#1a2275 0%,#0f1548 22%,#0c0c0e 52%,var(--bg) 100%);
  }
  .hero::before{ /* faint grid */
    content:"";position:absolute;inset:0;
    background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
    background-size:70px 70px;
    -webkit-mask-image:linear-gradient(180deg,#000 0%,transparent 55%);mask-image:linear-gradient(180deg,#000 0%,transparent 55%);
  }
  .silhouette{
    position:absolute;top:80px;left:50%;transform:translateX(-50%);
    width:min(400px,80vw);height:auto;z-index:1;
    -webkit-mask-image:linear-gradient(180deg,#000 55%,transparent 100%);mask-image:linear-gradient(180deg,#000 55%,transparent 100%);
  }
  .hero > *:not(.silhouette){position:relative;z-index:2}
  .hero h1{font-size:clamp(26px,4.6vw,50px);line-height:1.08;font-weight:700;letter-spacing:-.04em;margin-top:26px}
  .hero h1 em{display:block;font-size:1.12em;letter-spacing:-.02em;margin-top:6px;
    background:linear-gradient(180deg,#fff,#a7b0d6);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p{max-width:560px;margin-top:32px;font-size:clamp(16px,2vw,20px);line-height:1.65;color:#a9a9ad;font-weight:400}
  .hero p b{color:#fff;font-weight:500}
  .socials{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:44px}
  .soc{
    width:80px;height:62px;border-radius:999px;border:2px solid rgba(255,255,255,.25);
    background:rgba(20,20,22,.8);display:grid;place-items:center;color:#fff;
    box-shadow:0 0 0 3px rgba(255,255,255,.04) inset;transition:transform .2s,background .2s
  }
  .soc:hover{transform:translateY(-3px)}
  .soc.primary{background:#fff;color:#111;box-shadow:0 0 28px rgba(255,255,255,.35)}
  .soc svg{width:28px;height:28px;fill:currentColor}

  /* ---------- MARQUEE ---------- */
  .marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg);padding:44px 0;overflow:hidden;display:flex;flex-direction:column;gap:28px}
  .track{display:flex;width:max-content;gap:40px;font-size:clamp(40px,8vw,72px);font-weight:800;letter-spacing:-.03em;white-space:nowrap;
    background:linear-gradient(90deg,#555,#e8e8ea,#777);-webkit-background-clip:text;background-clip:text;color:transparent;
    animation:slide 28s linear infinite}
  .track.rev{animation-direction:reverse}
  .track span{display:inline-block}
  .track i{font-style:normal;opacity:.7;margin:0 10px}
  @keyframes slide{to{transform:translateX(-50%)}}
  .marquee{-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}

  /* ---------- ABOUT ---------- */
  .about{padding:110px 20px 120px;text-align:center;background:linear-gradient(180deg,#1b1c24 0%,#13120f 12%,#110f0c 100%);position:relative}
  .eyebrow{font-size:16px;letter-spacing:.22em;color:#8d8d92;font-weight:400}
  .about h2{font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(40px,7vw,64px);margin-top:20px;letter-spacing:-.01em;
    background:linear-gradient(180deg,#fff,#a9b0cf);-webkit-background-clip:text;background-clip:text;color:transparent}
  .about .statement{max-width:960px;margin:90px auto 0;font-size:clamp(28px,5vw,50px);line-height:1.38;font-weight:600;letter-spacing:-.035em}
  .about .statement em{color:#c9cde0;font-size:1.06em;letter-spacing:-.02em}

  /* ---------- PARTNER ---------- */
  .partner{background:#0a0a0a;padding:110px 20px;text-align:center;border-top:1px solid var(--line)}
  .partner h3{font-size:clamp(36px,6.5vw,62px);font-weight:700;letter-spacing:-.045em;line-height:1.15}
  .partner h3 em{display:block;font-size:1.1em;color:#d5d8e8;letter-spacing:-.02em}
  .partner p{margin:30px auto 0;max-width:520px;font-size:17px;line-height:1.6;color:var(--muted)}


  /* ---------- TRADES ---------- */
  .trades{padding:100px 20px;text-align:center;background:linear-gradient(180deg,#0a0a0a,#0f1030 140%);border-top:1px solid var(--line)}
  .trades h3{font-size:clamp(32px,5.5vw,50px);font-weight:700;letter-spacing:-.04em}
  .trades h3 em{color:#c9cde0}
  .gallery{max-width:900px;margin:44px auto 0;padding:12px;border:1px solid var(--line);border-radius:26px;background:#0d0d10;
    display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .gallery button{border:0;padding:0;background:#000;border-radius:16px;overflow:hidden;aspect-ratio:3/4;cursor:zoom-in;transition:transform .2s,box-shadow .2s}
  .gallery button:hover{transform:scale(1.02);box-shadow:0 0 0 2px rgba(255,213,74,.5)}
  .gallery img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
  @media (max-width:520px){.gallery{gap:6px;padding:8px;border-radius:20px}.gallery button{border-radius:12px}}
  .lightbox{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.94);display:none;align-items:center;justify-content:center;padding:56px 12px 40px}
  .lightbox.open{display:flex}
  .lightbox img{max-width:100%;max-height:100%;border-radius:12px;object-fit:contain}
  .lightbox button{position:absolute;background:rgba(255,255,255,.12);border:0;color:#fff;cursor:pointer;border-radius:50%;width:46px;height:46px;font-size:26px;line-height:1;display:grid;place-items:center}
  .lightbox .x{top:10px;right:12px}
  .lightbox .prev{left:8px;top:50%;transform:translateY(-50%)}
  .lightbox .next{right:8px;top:50%;transform:translateY(-50%)}
  .lightbox .count{position:absolute;bottom:12px;left:0;right:0;font-family:var(--mono);font-size:13px;color:#a9a9ad}

  /* ---------- FEEDBACK ---------- */
  .feedback{padding:90px 20px;text-align:center;background:var(--bg-2);border-top:1px solid var(--line)}
  .feedback h3{font-size:clamp(32px,5.5vw,50px);font-weight:700;letter-spacing:-.04em}
  .feedback h3 em{color:#c9cde0}
  .feedback form{max-width:640px;margin:40px auto 0;display:flex;flex-direction:column;gap:14px}
  .feedback input,.feedback textarea{
    width:100%;padding:16px 22px;background:#141414;border:1.5px solid rgba(255,255,255,.14);color:#fff;
    border-radius:24px;font:inherit;font-size:16px;outline:none;resize:vertical
  }
  .feedback input:focus,.feedback textarea:focus{border-color:#fff}
  .feedback textarea{min-height:140px}
  .btn{
    align-self:center;padding:16px 40px;border-radius:999px;border:0;background:#fff;color:#111;
    font:inherit;font-weight:600;font-size:16px;cursor:pointer;transition:transform .2s
  }
  .btn:hover{transform:translateY(-2px)}
  .thanks{display:none;margin-top:30px;color:#a9a9ad;font-size:16px}

  /* ---------- COMMUNITY ---------- */
  .community{padding:100px 20px;text-align:center;background:linear-gradient(180deg,#0b0a09,#121a52 140%);border-top:1px solid var(--line)}
  .community h3{font-size:clamp(32px,5.5vw,50px);font-weight:700;letter-spacing:-.04em}
  .community h3 em{color:#c9cde0}
  .community p{margin:24px auto 40px;max-width:520px;font-size:17px;line-height:1.6;color:var(--muted)}
  .community .btn{display:inline-flex;align-items:center;gap:14px}
  .community .btn svg{width:24px;height:24px}

  footer{padding:36px 20px;text-align:center;color:#6d6d70;font-size:14px;border-top:1px solid var(--line);background:#070707}

  /* ---------- DESKTOP TUNING ---------- */
  @media (min-width:900px){
    .nav{height:60px;padding:0 34px}
    .soc{width:92px;height:68px}
    .soc svg{width:30px;height:30px}
    .hero{padding-top:240px}
    .overlay .join{height:72px;font-size:17px}
    .overlay li a{padding:20px 0}
  }
  @media (prefers-reduced-motion:reduce){.track,.topbar,.topbar::after,.xau .word,.gold-icons .float,.age-badge i{animation:none}html{scroll-behavior:auto}}
  :focus-visible{outline:2px solid #fff;outline-offset:3px}
</style>
</head>
